DISCORD_TOKEN=paste-your-bot-token-here

# Optional: Xaman wallet linking (/wallet link). Free keys at https://apps.xumm.dev
# Leave empty to keep wallet linking off.
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Optional: your own XRPL JSON-RPC servers, comma separated (defaults are in config.json)
# XRPL_RPC=https://xrplcluster.com/

# Optional: where Bouncer keeps its data (on Railway, point this at a volume)
# BOUNCER_DATA_FILE=/data/bouncer.json

# Optional: path to a different config file
# BOUNCER_CONFIG=./config.json
